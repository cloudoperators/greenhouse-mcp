{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assigneesFromCodeOwners": true,
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "constraints": {
    "go": "1.27"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump golangci-lint version in the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*\\?=\\s*(?<currentValue>v?(?:\\d+\\.){0,2}\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "golangci/golangci-lint",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Bump kustomize version in the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "KUSTOMIZE_VERSION\\s*\\?=\\s*(?<currentValue>v?(?:\\d+\\.){0,2}\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "extractVersionTemplate": "^kustomize/v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "groupName": "Github Actions updates",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "extends": [
        "helpers:pinGitHubActionDigests"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "golang",
      "matchDatasources": [
        "docker",
        "go-version"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "/golang/"
      ]
    },
    {
      "groupName": "kubernetes packages",
      "groupSlug": "kubernetes-go",
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "k8s.io/api{/,}**",
        "k8s.io/apiextensions-apiserver{/,}**",
        "k8s.io/apimachinery{/,}**",
        "k8s.io/apiserver{/,}**",
        "k8s.io/cli-runtime{/,}**",
        "k8s.io/client-go{/,}**",
        "k8s.io/code-generator{/,}**",
        "k8s.io/component-base{/,}**",
        "k8s.io/kubectl{/,}**",
        "k8s.io/utils{/,}**",
        "sigs.k8s.io/controller-runtime{/,}**"
      ]
    },
    {
      "groupName": "flux packages",
      "groupSlug": "flux-go",
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "github.com/fluxcd{/,}**"
      ]
    },
    {
      "groupName": "kustomize (Makefile)",
      "groupSlug": "kustomize-regex",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepNames": [
        "kubernetes-sigs/kustomize"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "golangci-lint (Makefile)",
      "groupSlug": "golangci-lint",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepNames": [
        "golangci/golangci-lint"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "ginkgo & gomega updates",
      "groupSlug": "ginkgo-gomega",
      "matchDatasources": [
        "go"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "github.com/onsi{/,}**"
      ]
    },
    {
      "groupName": "golang.org/x packages",
      "groupSlug": "golang-x-go",
      "matchDatasources": [
        "go"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "golang.org/x{/,}**"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "separateMinorPatch": true
}